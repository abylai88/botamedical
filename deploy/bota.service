# Сайт BOTA как служба systemd. Устанавливается deploy/install.sh в /etc/systemd/system/bota.service.
[Unit]
Description=BOTA — сайт медицинской одежды
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=bota
Group=bota
# Рабочая версия сайта: ссылка на папку в /srv/bota/releases (её переключает bota-update).
# Код принадлежит root: пользователь bota может его только читать.
WorkingDirectory=/srv/bota/current
# Сайт слушает только 127.0.0.1: снаружи к нему ходит лишь Caddy.
Environment=NODE_ENV=production
Environment=PORT=3000
Environment=BOTA_BIND_HOST=127.0.0.1
Environment=NEXT_TELEMETRY_DISABLED=1
# Данные сайта (то же, что .local на компьютере): база, order-key, загруженные фото.
Environment=BOTA_DATA_DIR=/var/lib/bota/data
# Сайт стоит за одним доверенным прокси (Caddy), лимиты считаются по IP посетителя.
Environment=TRUST_PROXY=1
# Адрес сайта (APP_ORIGIN) — в этом файле, он у каждого сервера свой.
EnvironmentFile=/etc/bota/bota.env
ExecStart=/usr/bin/node scripts/run-next.mjs start
Restart=on-failure
RestartSec=5
TimeoutStopSec=20

# Писать сайт может только в свои данные (/var/lib/bota) и кеш картинок Next.js (/var/cache/bota,
# туда ведёт ссылка .next/cache). Обе папки создаёт systemd, доступ только у bota.
StateDirectory=bota
StateDirectoryMode=0700
CacheDirectory=bota
CacheDirectoryMode=0700
UMask=0077
ProtectSystem=strict
ReadWritePaths=/var/lib/bota /var/cache/bota

# Изоляция: даже взломанный сайт не получит прав root, не увидит /home и /root,
# не тронет ядро, устройства и чужие процессы.
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
SystemCallFilter=@system-service
# Запрещённый системный вызов возвращает ошибку, а не убивает процесс: Node.js в таком случае
# сам выбирает обходной путь.
SystemCallErrorNumber=EPERM
# MemoryDenyWriteExecute не включаем: движок V8 в Node.js создаёт исполняемый код на лету.

[Install]
WantedBy=multi-user.target
