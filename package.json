{
  "name": "bota-group",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "node scripts/run-next.mjs dev",
    "build": "node scripts/run-next.mjs build",
    "start": "node scripts/run-next.mjs start",
    "typecheck": "tsc --noEmit",
    "admin:create": "node --conditions=react-server scripts/admin.mjs",
    "key:create": "node scripts/order-key.mjs",
    "db:verify": "node --conditions=react-server scripts/db-verify.mjs",
    "import:scrubs": "node --conditions=react-server scripts/import-scrubs.mjs",
    "fix:origin": "node --conditions=react-server scripts/fix-origin.mjs",
    "assets": "node scripts/assets.mjs",
    "test": "node --conditions=react-server --test tests/*.test.mjs",
    "test:deploy": "bash deploy/tests/run.sh"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "next": "16.4.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  }
}
